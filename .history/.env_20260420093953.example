# Safe starter environment variables for this Vite app.
# Copy to .env.local (or .env) and replace values as needed.
# Only VITE_* variables are exposed to client-side code.

# App settings
VITE_APP_NAME=Task Management
VITE_APP_ENV=development

# API settings (public base URL only; do not place secrets in frontend env files)
VITE_API_BASE_URL=http://localhost:3000

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=true
